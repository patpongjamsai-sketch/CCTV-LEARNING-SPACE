# ค่าที่ Browser ใช้ได้ (ตั้งใน Supabase Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Server-only: ห้ามเติม NEXT_PUBLIC_ และห้าม commit ค่าจริง
SUPABASE_SECRET_KEY=sb_secret_your_key

# Supavisor Transaction Pooler สำหรับ Vercel: port 6543 + SSL
# เปลี่ยน [YOUR-PASSWORD] และ project-ref ก่อนใช้งานจริง
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require

# URL หลักของระบบ ใช้สร้างลิงก์เชิญและลิงก์ตั้งรหัสผ่าน
NEXT_PUBLIC_SITE_URL=http://localhost:3000
